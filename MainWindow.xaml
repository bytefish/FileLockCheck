<Window x:Class="FileLockCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileLockCheck"
        xmlns:converters="clr-namespace:FileLockCheck.Converters"
        xmlns:res="clr-namespace:FileLockCheck.Properties"
        Title="{x:Static res:Resources.WindowTitle}" Height="450" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="{x:Static res:Resources.HeaderTitle}" FontSize="24" FontWeight="SemiBold" Foreground="#4DA8DA" Margin="0,0,0,15"/>

        <!-- Datei-Informationen -->
        <Border Grid.Row="1" Background="#2D2D30" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="{x:Static res:Resources.SelectedFileLabel}" FontSize="12" Foreground="#AAAAAA"/>
                <TextBlock Text="{Binding TargetFilePath}" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="14" Margin="0,0,0,10" FontWeight="SemiBold"
                   Foreground="{Binding HasLocks, Converter={StaticResource BooleanToBrushConverter}}"/>

        <!-- Prozess-Liste -->
        <Border Grid.Row="3" Background="#252526" CornerRadius="5" Padding="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LockingProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#333337" CornerRadius="4" Padding="10" Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Linke Spalte: Icon und Prozess-ID -->
                                    <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Top">
                                        <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,0,8" Stretch="Uniform"/>
                                        <Border Background="#D32F2F" CornerRadius="3" Padding="5,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessId, StringFormat=PID: {0}}" FontSize="11" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Rechte Spalte: Detaillierte Informationen -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ProcessName}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#CCCCCC" FontStyle="Italic" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>

                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Resources.PathLabel}" FontSize="11" Foreground="#888888" Margin="0,0,10,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExePath}" FontSize="11" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Resources.RamLabel}" FontSize="11" Foreground="#888888" Margin="0,0,10,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryUsage}" FontSize="11" Foreground="#AAAAAA"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Resources.StartLabel}" FontSize="11" Foreground="#888888" Margin="0,0,10,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StartTime}" FontSize="11" Foreground="#AAAAAA"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Rechte Spalte: Prozess beenden Button -->
                                    <Button Grid.Column="2" Content="{x:Static res:Resources.KillProcessButton}"
                                            VerticalAlignment="Center" Padding="10,5" Margin="10,0,0,0"
                                            Background="#D32F2F" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            Click="KillProcess_Click" ToolTip="{x:Static res:Resources.KillProcessButton}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <!-- Einstellungen / Shortcut-Konfiguration -->
        <Border Grid.Row="4" Background="#2D2D30" CornerRadius="5" Padding="10" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Resources.ShortcutLabel}" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,10,0"/>

                <TextBox x:Name="HotkeyTextBox" Grid.Column="1" Background="#1E1E1E" Foreground="White" BorderBrush="#555" 
                         Padding="5" IsReadOnly="True" Cursor="Hand" TextAlignment="Center" FontWeight="Bold"
                         ToolTip="{x:Static res:Resources.ShortcutTooltip}"
                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
            </Grid>
        </Border>
    </Grid>
</Window>